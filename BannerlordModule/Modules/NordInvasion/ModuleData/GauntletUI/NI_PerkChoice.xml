<Prefabs>
  <Prefab Name="NI_PerkChoice" DataSource="NI_PerkChoice_VM">
    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1000" SuggestedHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Singleplayer.Window">
      <Children>
        <TextWidget Text="Choose a Perk! Wave Bonus" HorizontalAlignment="Center" MarginTop="20" Brush="Singleplayer.Text"/>
        <TextWidget DataSource="{TimeLeft}" Text="Time: {TimeLeft}s" HorizontalAlignment="Center" MarginTop="50" Brush="Singleplayer.Text"/>
        
        <Widget SuggestedWidth="900" SuggestedHeight="400" HorizontalAlignment="Center" MarginTop="100" LayoutImp="Horizontal">
          <Children>
            <ButtonWidget DataSource="{Choose1Command}" SuggestedWidth="280" SuggestedHeight="350" MarginRight="20" Brush="Singleplayer.Button">
              <Children>
                <TextWidget DataSource="{Perk1Name}" MarginTop="20" HorizontalAlignment="Center" Brush="Singleplayer.Text"/>
                <TextWidget DataSource="{Perk1Desc}" MarginTop="60" HorizontalAlignment="Center" Brush="Singleplayer.Text"/>
              </Children>
            </ButtonWidget>
            <ButtonWidget DataSource="{Choose2Command}" SuggestedWidth="280" SuggestedHeight="350" MarginRight="20">
              <Children>
                <TextWidget DataSource="{Perk2Name}" MarginTop="20" HorizontalAlignment="Center"/>
                <TextWidget DataSource="{Perk2Desc}" MarginTop="60" HorizontalAlignment="Center"/>
              </Children>
            </ButtonWidget>
            <ButtonWidget DataSource="{Choose3Command}" SuggestedWidth="280" SuggestedHeight="350">
              <Children>
                <TextWidget DataSource="{Perk3Name}" MarginTop="20" HorizontalAlignment="Center"/>
                <TextWidget DataSource="{Perk3Desc}" MarginTop="60" HorizontalAlignment="Center"/>
              </Children>
            </ButtonWidget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Prefab>
</Prefabs>
