        <ButtonWidget DataSource="{BuyOilCommand}" Text="Buy Oil Cauldron (200g + 10w 5m)" MarginTop="330" SuggestedWidth="400" HorizontalAlignment="Center"/>
        <ButtonWidget DataSource="{BuyBallistaCommand}" Text="Buy Ballista (300g + 15w 10m)" MarginTop="380" SuggestedWidth="400" HorizontalAlignment="Center"/>
        <ButtonWidget DataSource="{CloseCommand}" Text="Close (ESC)" MarginTop="600" SuggestedWidth="200" HorizontalAlignment="Center"/>
