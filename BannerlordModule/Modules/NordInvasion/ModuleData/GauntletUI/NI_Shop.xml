      <Children>
        <TextWidget DataSource="{GoldText}" HorizontalAlignment="Center" MarginTop="20" Brush="Singleplayer.Text"/>
        <ButtonWidget DataSource="{BuySwordCommand}" Text="Buy Sword (50g)" MarginTop="80" SuggestedWidth="400" HorizontalAlignment="Center" Brush="Singleplayer.Button"/>
        <ButtonWidget DataSource="{BuyBowCommand}" Text="Buy Bow (80g)" MarginTop="130" SuggestedWidth="400" HorizontalAlignment="Center"/>
        <ButtonWidget DataSource="{BuyArmorCommand}" Text="Buy Armor (100g)" MarginTop="180" SuggestedWidth="400" HorizontalAlignment="Center"/>
