<Module>
    <Name value="Nord Invasion Better Edition"/>
    <Id value="NordInvasion"/>
    <Version value="v2.3.0"/>
    <SingleplayerModule value="true"/>
    <MultiplayerModule value="true"/>
    <ModuleCategory value="Multiplayer"/>
    <DependedModules>
        <!-- Сборка под Bannerlord 1.4.8 (без War Sails / морского DLC).
             ButterLib/UIExtenderEx/MCM в коде не используются — убраны из жёстких
             зависимостей, чтобы модуль работал на чистой 1.4.8 без лишних модов. -->
        <DependedModule Id="Native"/>
        <DependedModule Id="SandBoxCore"/>
        <DependedModule Id="Sandbox"/>
        <DependedModule Id="CustomBattle"/>
        <DependedModule Id="Multiplayer" DependentVersion="e1.4.8" Optional="false"/>
        <DependedModule Id="StoryMode" DependentVersion="e1.4.8" Optional="true"/>
    </DependedModules>
    <SubModules>
        <SubModule>
            <Name value="NordInvasion"/>
            <DLLName value="NordInvasion.dll"/>
            <SubModuleClassType value="NordInvasion.SubModule"/>
            <Tags>
                <!-- Для DedicatedCustomServer: Battle = сервер рендерит только AI, IsNoRenderOnlyAIs false = с рендером -->
                <Tag key="DedicatedServerType" value="Battle" />
                <Tag key="IsNoRenderOnlyAIs" value="false" />
            </Tags>
        </SubModule>
    </SubModules>
    <Xmls>
        <!-- Пути относительны к папке ModuleData/ -->
        <XmlNode>
            <XmlName id="Characters" path="Characters.xml"/>
        </XmlNode>
        <XmlNode>
            <XmlName id="Items" path="Items.xml"/>
        </XmlNode>
        <XmlNode>
            <XmlName id="SceneProps" path="SceneProps.xml"/>
        </XmlNode>
        <XmlNode>
            <XmlName id="Missions" path="Missions.xml"/>
        </XmlNode>
        <XmlNode>
            <XmlName id="MultiplayerScenes" path="MultiplayerScenes.xml"/>
        </XmlNode>
        <XmlNode>
            <XmlName id="MultiplayerMaps" path="MultiplayerMaps.xml"/>
        </XmlNode>
    </Xmls>
</Module>
