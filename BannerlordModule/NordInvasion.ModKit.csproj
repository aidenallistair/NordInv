<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ModKit версия проекта для сборки с реальными DLL игры.
    Используй этот csproj когда у тебя установлен Bannerlord + Modding Kit.

    Сборка:
      dotnet build NordInvasion.ModKit.csproj -c Release -p:BannerlordPath="C:\...\Mount & Blade II Bannerlord"
    Или задай переменную окружения BANNERLORD_PATH.

    Выдаёт DLL сразу в Modules/NordInvasion/bin/Win64_Shipping_Client/ и Server/
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>NordInvasion</AssemblyName>
    <RootNamespace>NordInvasion</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Путь к игре можно передать через /p:BannerlordPath=... или env BANNERLORD_PATH -->
    <BannerlordPath Condition="'$(BannerlordPath)' == '' and '$(BANNERLORD_PATH)' != ''">$(BANNERLORD_PATH)</BannerlordPath>
    <BannerlordPath Condition="'$(BannerlordPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordPath>
    <OutputPath>Modules\NordInvasion\bin\Win64_Shipping_Client\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />

    <!-- TaleWorlds - берём из установленной игры (ModKit) -->
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.InputSystem">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade.GauntletUI">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.GauntletUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.GauntletUI">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.GauntletUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.GauntletUI.Data">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.GauntletUI.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Для MP сервера - те же DLL, но в Dedicated Server папке, для клиента хватает Client DLL -->
    <!-- Harmony / ButterLib не используются в коде (модуль работает на чистой 1.4.8 без них) -->
  </ItemGroup>

  <!-- Копируем DLL в Server папку после сборки, чтобы Dedicated сервер видел -->
  <Target Name="CopyToServer" AfterTargets="Build">
    <MakeDir Directories="Modules\NordInvasion\bin\Win64_Shipping_Server\" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="Modules\NordInvasion\bin\Win64_Shipping_Server\" SkipUnchangedFiles="true" />
    <Message Text="Copied $(AssemblyName).dll to Server bin" Importance="high" />
  </Target>
</Project>
