<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>NordInvasion</AssemblyName>
    <RootNamespace>NordInvasion</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>Modules\NordInvasion\bin\Win64_Shipping_Client\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />

    <!-- Bannerlord reference assemblies from NuGet (no local game install needed).
         Сборка под Bannerlord 1.4.8 (build 119303) — совпадает с версией игры 1.4.8.1193.
         War Sails DLC (NavalDLC) в коде не используется; модуль работает без него. -->
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="1.4.8.119303" PrivateAssets="All" />
  </ItemGroup>
</Project>
